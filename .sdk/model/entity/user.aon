# Entity: user

main: kit: entity: user: {

  alias: field: {}

  fields: [
    {
      name: "createdAt"
      req: false
      short: "Timestamp when the user account was created"
      type: "`$STRING`"
    }
    {
      name: "email"
      req: false
      short: "User's email address"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      short: "Unique identifier for the user"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "updatedAt"
      req: false
      short: "Timestamp when the user account was last updated"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "user"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/users"
          parts: [
            "users"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
