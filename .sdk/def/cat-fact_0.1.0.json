{
  "openapi": "3.0.3",
  "info": {
    "title": "Cat Fact API",
    "description": "An API that shows different Cat Facts! Daily cat facts! 🐱",
    "version": "1.0.0",
    "contact": {
      "name": "API Support",
      "url": "https://alexwohlbruck.github.io/cat-facts/docs/"
    }
  },
  "servers": [
    {
      "url": "https://cat-fact.herokuapp.com",
      "description": "Production server"
    }
  ],
  "paths": {
    "/facts": {
      "get": {
        "summary": "Retrieve and query facts",
        "description": "Retrieve cat facts from the database. The response time will likely be a few seconds long on the first request, because this app is running on a free Heroku dyno. Subsequent requests will behave as normal.",
        "operationId": "getFacts",
        "tags": [
          "Facts"
        ],
        "parameters": [
          {
            "name": "animal_type",
            "in": "query",
            "description": "Filter facts by animal type",
            "required": false,
            "schema": {
              "type": "string",
              "default": "cat"
            }
          },
          {
            "name": "amount",
            "in": "query",
            "description": "Number of facts to return",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with cat facts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Fact"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/facts/random": {
      "get": {
        "summary": "Get random fact",
        "description": "Retrieve a random cat fact",
        "operationId": "getRandomFact",
        "tags": [
          "Facts"
        ],
        "parameters": [
          {
            "name": "animal_type",
            "in": "query",
            "description": "Filter facts by animal type",
            "required": false,
            "schema": {
              "type": "string",
              "default": "cat"
            }
          },
          {
            "name": "amount",
            "in": "query",
            "description": "Number of facts to return",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with random cat fact(s)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fact"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/users": {
      "get": {
        "summary": "Get user data",
        "description": "Retrieve user data. Requires authentication. As of now, this can only be achieved by logging in manually on the website.",
        "operationId": "getUsers",
        "tags": [
          "Users"
        ],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with user data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Fact": {
        "type": "object",
        "description": "An animal fact",
        "properties": {
          "_id": {
            "type": "string",
            "description": "Unique identifier for the fact"
          },
          "text": {
            "type": "string",
            "description": "The fact text content"
          },
          "type": {
            "type": "string",
            "description": "The type of animal the fact is about",
            "example": "cat"
          },
          "user": {
            "type": "string",
            "description": "User ID who submitted the fact"
          },
          "upvotes": {
            "type": "integer",
            "description": "Number of upvotes the fact has received"
          },
          "userUpvoted": {
            "type": "boolean",
            "description": "Whether the current user has upvoted this fact"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the fact was created"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the fact was last updated"
          },
          "deleted": {
            "type": "boolean",
            "description": "Whether the fact has been deleted"
          },
          "used": {
            "type": "boolean",
            "description": "Whether the fact has been used"
          }
        },
        "required": [
          "_id",
          "text",
          "type"
        ]
      },
      "User": {
        "type": "object",
        "description": "A user of the Cat Facts site",
        "properties": {
          "_id": {
            "type": "string",
            "description": "Unique identifier for the user"
          },
          "name": {
            "type": "object",
            "properties": {
              "first": {
                "type": "string",
                "description": "User's first name"
              },
              "last": {
                "type": "string",
                "description": "User's last name"
              }
            }
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "User's email address"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the user account was created"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the user account was last updated"
          }
        },
        "required": [
          "_id"
        ]
      },
      "Error": {
        "type": "object",
        "description": "Error response",
        "properties": {
          "message": {
            "type": "string",
            "description": "Error message"
          },
          "status": {
            "type": "integer",
            "description": "HTTP status code"
          }
        }
      }
    },
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "connect.sid",
        "description": "Session cookie authentication. Requires logging in manually on the website."
      }
    }
  },
  "tags": [
    {
      "name": "Facts",
      "description": "Operations related to cat facts"
    },
    {
      "name": "Users",
      "description": "Operations related to users (requires authentication)"
    }
  ]
}
