    "GET /facts": {
      "provenance": "operation-contract",
      "contract": {
        "operationId": "getFacts",
        "parameters": [
          {
            "description": "Filter facts by animal type",
            "in": "query",
            "name": "animal_type",
            "required": false,
            "schema": {
              "default": "cat",
              "type": "string"
            }
          },
          {
            "description": "Number of facts to return",
            "in": "query",
            "name": "amount",
